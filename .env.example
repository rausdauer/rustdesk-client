# Copy this file to .env. Paste the contents of id_ed25519.pub below.
# This is the PUBLIC key, never the private id_ed25519 file.
RUSTDESK_SERVER_KEY=
# These addresses must be reachable FROM the web container.
# On a shared Docker network use hbbs:21118 and hbbr:21119 instead.
RUSTDESK_ID_UPSTREAM=vnc.edvlab.tuwien.ac.at:21118
RUSTDESK_RELAY_UPSTREAM=vnc.edvlab.tuwien.ac.at:21119
