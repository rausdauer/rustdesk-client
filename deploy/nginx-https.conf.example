# On the Docker HOST / existing HTTPS Nginx reverse proxy.
# Replace studentdesk.example.com and certificate paths with your frontend domain.
# The web container now handles /ws/id and /ws/relay internally.
# If this proxy is also a container, use http://web:80 on a shared network
# instead of http://127.0.0.1:8080 (localhost means that proxy container).
map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}
server {
    listen 443 ssl;
    server_name studentdesk.example.com;
    ssl_certificate /etc/letsencrypt/live/studentdesk.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/studentdesk.example.com/privkey.pem;
    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }
}
